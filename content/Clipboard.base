views:
  - type: table
    name: 표
    filters:
      and:
        - parent.contains(link("📋 Clipboard"))
    order:
      - file.name
      - file.ctime
      - file.mtime
    sort:
      - property: file.name
        direction: ASC
      - property: file.mtime
        direction: DESC
    summaries: {}
    separator: ""
    indentProperties: true
    imageAspectRatio: 0.5
    columnSize: {}
