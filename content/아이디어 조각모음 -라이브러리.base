views:
  - type: table
    name: 표
    filters:
      and:
        - parent == ["[[index]]"]
        - file.tags.contains("Meta")
    order:
      - file.name
      - file.tags
      - file.ctime
      - file.mtime
    sort:
      - property: order
        direction: ASC
    summaries: {}
    separator: ""
    indentProperties: true
    imageAspectRatio: 0.5
    columnSize: {}
