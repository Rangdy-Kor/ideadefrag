views:
  - type: cards
    name: 카드
    order:
      - file.name
      - file.ctime
      - file.mtime
      - parent
    sort:
      - property: order
        direction: ASC
    summaries: {}
    separator: ""
    indentProperties: true
    imageAspectRatio: 0.5
    columnSize: {}
    cardSize: 400
