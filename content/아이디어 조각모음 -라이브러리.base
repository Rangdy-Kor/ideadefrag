views:
  - type: cards
    name: 카드
    filters:
      and:
        - parent.contains(link("index"))
    order:
      - file.name
      - file.ctime
      - file.mtime
    sort:
      - property: order
        direction: ASC
    summaries: {}
    separator: ""
    indentProperties: true
    imageAspectRatio: 0.5
    columnSize: {}
    cardSize: 400
